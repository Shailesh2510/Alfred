{
	"extends": [
		"eslint:recommended",
		"next/core-web-vitals",
		"prettier",
		"plugin:cypress/recommended"
	],
	"plugins": ["prettier", "cypress"],
	"rules": {
		"prefer-const": "error",
		"no-var": "error",
		"no-unused-vars": ["error", { "argsIgnorePattern": "^_" }],
		"quote-props": ["warn", "as-needed"],
		"no-console": "warn",
		"curly": "error",
		"eqeqeq": ["error", "always"],
		"consistent-return": "error",
		"prettier/prettier": "error"
	}
}

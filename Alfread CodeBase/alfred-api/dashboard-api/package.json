{
  "name": "oms",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build && tsc --target es5 ./node_modules/clicksend/api.ts",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:generate": "npm run typeorm -- migration:generate -d database/datasource.ts",
    "migration:show": "npm run typeorm -- migration:show -d database/datasource.ts",
    "migration:run": "npm run typeorm -- migration:run -d database/datasource.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d database/datasource.ts",
    "seed:run": "export SEED_DB=true; npm run typeorm -- migration:run -d database/datasource.ts",
    "seed:revert": "export SEED_DB=true; npm run typeorm -- migration:revert -d database/datasource.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "setup:init": "node_modules/.bin/ts-node src/init.ts",
    "seed": "node_modules/.bin/ts-node src/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-appconfigdata": "^3.693.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.234.0",
    "@aws-sdk/client-lambda": "^3.236.0",
    "@aws-sdk/client-s3": "^3.306.0",
    "@aws-sdk/client-secrets-manager": "^3.306.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "@aws-sdk/s3-request-presigner": "^3.309.0",
    "@nestjs/cache-manager": "^1.0.0",
    "@nestjs/common": "^9.0.0",
    "@nestjs/config": "^2.2.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/event-emitter": "^1.4.1",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/schedule": "^2.2.1",
    "@nestjs/swagger": "^6.1.4",
    "@nestjs/typeorm": "^9.0.1",
    "@slack/web-api": "^7.9.0",
    "aws-sdk": "^2.1393.0",
    "bluebird": "^3.7.2",
    "cache-manager": "^4.1.0",
    "cache-manager-redis-store": "^2.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.13.2",
    "clicksend": "^5.0.79",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "decimal.js-light": "^2.5.1",
    "dotenv": "^16.0.3",
    "exceljs": "^4.3.0",
    "form-data": "^4.0.0",
    "http": "^0.0.1-security",
    "jsonwebtoken": "^9.0.0",
    "jwk-to-pem": "^2.0.5",
    "libphonenumber-js": "^1.10.58",
    "lodash": "^4.17.21",
    "mailgun.js": "^9.3.0",
    "pg": "^8.8.0",
    "pusher": "^5.1.2",
    "redis": "^4.6.5",
    "reflect-metadata": "^0.1.13",
    "request": "^2.88.2",
    "rimraf": "^3.0.2",
    "rxjs": "^7.2.0",
    "shipday": "^1.1.0",
    "stripe": "^12.3.0",
    "twilio": "^4.18.1",
    "typeorm": "^0.3.11",
    "uuid": "^10.0.0",
    "uuidv5": "^1.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^9.0.0",
    "@nestjs/schematics": "^9.0.0",
    "@nestjs/testing": "^9.0.0",
    "@types/cache-manager": "^4.0.1",
    "@types/express": "^4.17.13",
    "@types/jest": "28.1.8",
    "@types/jsonwebtoken": "^8.5.9",
    "@types/jwk-to-pem": "^2.0.1",
    "@types/lodash": "^4.17.13",
    "@types/node": "^16.18.68",
    "@types/supertest": "^2.0.11",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "axios": "^1.2.2",
    "eslint": "^8.0.1",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-prettier": "^4.0.0",
    "jest": "28.1.3",
    "prettier": "^2.3.2",
    "source-map-support": "^0.5.20",
    "supertest": "^6.1.3",
    "ts-jest": "28.0.8",
    "ts-loader": "^9.2.3",
    "ts-node": "^10.0.0",
    "tsconfig-paths": "4.1.0",
    "typescript": "^4.7.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "./",
    "modulePaths": [
      "<rootDir>"
    ],
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
